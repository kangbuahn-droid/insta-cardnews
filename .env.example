# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# 텔레그램 봇 (@BotFather 로 생성) / 내 채팅방 ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 인스타그램 (Instagram 로그인 방식 API)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_HOST=auto
IG_API_VERSION=v23.0

# 이미지 공개 저장소 (Cloudflare R2 권장)
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=insta-cardnews
S3_REGION=auto
PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

TZ_NAME=Asia/Seoul
