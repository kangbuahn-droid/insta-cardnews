# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# 텔레그램 봇 (@BotFather 로 생성) / 내 채팅방 ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 인스타그램 (Instagram 로그인 방식 API)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_HOST=auto
IG_API_VERSION=v23.0

# 이미지 공개 저장소 (Cloudflare R2 권장)
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=insta-cardnews
S3_REGION=auto
PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

TZ_NAME=Asia/Seoul

# AI 꿀팁 채널 그림 생성 (platform.openai.com > API keys). 비우면 그림 없이 디자인만으로 만듭니다.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=           # 비우면 쓸 수 있는 모델 자동 선택 (예: gpt-image-1, dall-e-3)
# IMAGE_PROVIDER=openai          # openai | gemini | none (비우면 키 있는 쪽 자동)
# OPENAI_IMAGE_QUALITY=medium    # low | medium | high (high 는 비쌈)
# IMAGE_MAX_PER_POST=4           # 게시물 하나에 만들 최대 그림 수
# GEMINI_API_KEY=
